rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 주소의 비밀 키(20자 이상)를 아는 사람만 해당 키 아래의 주간 문서를 읽고 쓸 수 있습니다.
    // checklists 컬렉션 전체를 나열하는 요청은 허용하지 않으므로 다른 키를 찾아낼 수 없습니다.
    match /checklists/{key}/weeks/{week} {
      allow read: if key.size() >= 20;

      allow create, update: if key.size() >= 20
        && week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['checks', 'skips', 'notes', 'updatedAt'])
        && request.resource.data.get('checks', {}).size() <= 200
        && request.resource.data.get('skips', {}).size() <= 200
        && request.resource.data.get('notes', {}).size() <= 300;

      allow delete: if false;
    }
  }
}
